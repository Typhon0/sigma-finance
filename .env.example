# docker-compose environment
# Copy to `.env` (git-ignored) and fill in real values before `docker compose up`.
# These are consumed by docker-compose.yml variable interpolation.

# Database connection used by the `server` service.
# DB_HOST is the reachable host of your PostgreSQL instance (not localhost if using the LAN).
DB_HOST=localhost
DB_PORT=5432
DB_USER=sigma_finance
DB_PASSWORD=change-me
DB_NAME=sigma_finance
DB_SSLMODE=disable
