# internal/handler/graphql/schema/account.graphqls

enum AccountType {
    BROKER
    BANK
    CRYPTO_EXCHANGE
    CRYPTO_WALLET
    OTHER
}

type Account {
    id: ID!
    portfolioId: ID!
    portfolio: Portfolio!
    name: String!
    type: AccountType!
    taxWrapper: TaxWrapperType!
    institution: String
    accountNumber: String
    currency: String!
    syncProvider: String!
    ownershipPercentage: Float!
    coOwnerName: String
    coOwnerUserId: ID
    coOwnerUser: User
    externalId: String
    syncConnection: SyncConnection
    positions: [Position!]!
    positionsCount: Int!
    totalValue: Float
    createdAt: Time!
    updatedAt: Time!
}

type CoOwnerCandidate {
    id: ID!
    name: String!
    email: String!
}

input CreateAccountInput {
    portfolioId: ID!
    name: String!
    type: AccountType!
    taxWrapper: TaxWrapperType!
    institution: String
    accountNumber: String
    currency: String
    syncProvider: String
    ownershipPercentage: Float
    coOwnerName: String
    coOwnerUserId: ID
}

input UpdateAccountInput {
    name: String
    type: AccountType
    taxWrapper: TaxWrapperType
    institution: String
    accountNumber: String
    currency: String
    ownershipPercentage: Float
    coOwnerName: String
    coOwnerUserId: ID
}

extend type Query {
    accounts(portfolioId: ID): [Account!]! @auth
    account(id: ID!): Account @auth
    coOwnerCandidates(search: String): [CoOwnerCandidate!]! @auth
}

extend type Mutation {
    createAccount(input: CreateAccountInput!): Account! @auth
    updateAccount(id: ID!, input: UpdateAccountInput!): Account! @auth
    deleteAccount(id: ID!): Boolean! @auth
}
