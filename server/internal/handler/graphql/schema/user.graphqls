# internal/handler/graphql/schema/user.graphqls

type User {
    id: ID!
    username: String!
    email: String!
    role: String!
    emailVerified: Boolean!
    lastLoginAt: Time
    failedLoginCount: Int!
    lockedUntil: Time
    isLocked: Boolean!
    createdAt: Time!
    updatedAt: Time!
    portfolios: [Portfolio!]!
    watchlists: [Watchlist!]!
    displayCurrency: String!
    themePreference: String!
    themeBaseColor: String!
    themeAccentColor: String!
    themeFontPreference: String!
    themeHeadingFont: String!
    themeMenuAccent: String!
    themeMenuColor: String!
    themeStyle: String!
    themeRadius: Float!
    themeRTL: Boolean!
    taxJurisdiction: String!
}

# --- Inputs & Enums for User ---

input CreateUserInput {
    username: String!
    email: String!
    password: String!
}

input UpdateUserInput {
    username: String
    email: String
    password: String
    taxJurisdiction: String
}

input UpdateUserTaxJurisdictionInput {
    taxJurisdiction: String!
}

input UpdateUserDisplayCurrencyInput {
    displayCurrency: String!
}

input UpdateUserThemePreferencesInput {
    themePreference: String!
    themeBaseColor: String!
    themeAccentColor: String!
    themeFontPreference: String!
    themeHeadingFont: String!
    themeMenuAccent: String!
    themeMenuColor: String!
    themeStyle: String!
    themeRadius: Float!
    themeRTL: Boolean!
}

input UserFilter {
    id: ID
    usernameContains: String
    email: String
}

input UserOrder {
    field: UserOrderField! = CREATED_AT
    direction: SortDirection! = DESC
}

enum UserOrderField {
    USERNAME
    EMAIL
    CREATED_AT
}

type AdminUserStats {
    totalUsers: Int!
    activeUsers: Int!
    lockedUsers: Int!
    adminUsers: Int!
    unverifiedUsers: Int!
}

type AdminUsersResponse {
    users: [User!]!
    totalCount: Int!
}

input AdminUserFilter {
    search: String
    role: String
    isLocked: Boolean
    emailVerified: Boolean
}

input AdminCreateUserInput {
    name: String!
    email: String!
    password: String!
    role: String
    emailVerified: Boolean
}

input AdminUpdateUserInput {
    name: String
    email: String
    role: String
    taxJurisdiction: String
    displayCurrency: String
}

extend type Query {
    adminUsers(filter: AdminUserFilter, pagination: PaginationInput, orderBy: UserOrder): AdminUsersResponse! @auth
    adminUserStats: AdminUserStats! @auth
}

extend type Mutation {
    adminCreateUser(input: AdminCreateUserInput!): User! @auth
    adminUpdateUser(id: ID!, input: AdminUpdateUserInput!): User! @auth
    adminSetUserRole(id: ID!, role: String!): User! @auth
    adminSetUserLock(id: ID!, locked: Boolean!, lockUntil: Time): User! @auth
    adminSetUserPassword(id: ID!, password: String!): Boolean! @auth
    adminSetUserEmailVerified(id: ID!, verified: Boolean!): User! @auth
    adminDeleteUser(id: ID!, hardDelete: Boolean! = false): Boolean! @auth
}
