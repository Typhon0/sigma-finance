# internal/handler/graphql/schema/alert_report.graphqls

# An enumeration for different ways to be notified.
enum NotificationType {
    EMAIL
    SMS
    PUSH
}

# An alert on an asset based on a specific condition.
type Alert {
    id: ID!
    condition: String!
    notificationType: NotificationType!
    createdAt: Time!
    triggeredAt: Time

    # Relationships
    user: User!
    asset: Asset!
}

# A generated report of a user's financial data.
type Report {
    id: ID!
    name: String!
    generatedAt: Time!
    reportData: String # Could also be a JSON scalar for structured data.

    # Relationships
    user: User!
}