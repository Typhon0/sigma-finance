    bedrooms: Int
    bathrooms: Float
    rooms: Int
    floor: Int
    totalFloors: Int
    garages: Int
    parkingSpaces: Int
    energyLabel: String
    condition: String

    # Fees & Acquisition Costs
    agencyFees: Float
    notaryFees: Float
