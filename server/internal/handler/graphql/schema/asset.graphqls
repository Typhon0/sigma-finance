# internal/handler/graphql/schema/asset.graphqls

type AssetType {
    id: ID!
    name: String!
}

interface Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!
    positions: [Position!]!
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
}

type Stock implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    ticker: String!
    quantity: Float!
    buyingPrice: Float
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
    # Instrument reference metrics. All nullable: null means the data provider
    # has not supplied the figure, which is not the same as zero. Clients must
    # not substitute a default - a guessed expense ratio becomes an annual fee
    # in currency that the user budgets against.
    peRatio: Float
    dividendYield: Float
}

type Crypto implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    walletAddress: String
    blockchainNetwork: String
    quantity: Float!
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Fund implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    ticker: String!
    quantity: Float!
    buyingPrice: Float
    sector: String
    exchange: String
    fundType: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
    # Annual total expense ratio, as a percentage (0.03 = 3%). Null when
    # unknown. See the note on Stock.peRatio about not defaulting it.
    expenseRatio: Float
    dividendYield: Float
}

type BankAccount implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    accountType: String!
    institution: String!
    accountNumber: String!
    currency: String!
    interestRate: Float
    balance: Float
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type RealEstate implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    propertyType: String!
    category: String
    address: String!
    city: String!
    state: String
    country: String!
    zipCode: String
    squareFeet: Int
    landSurface: Float
    yearBuilt: Int
    bedrooms: Int
    bathrooms: Float
    rooms: Int
    floor: Int
    totalFloors: Int
    garages: Int
    parkingSpaces: Int
    energyLabel: String
    condition: String

    # Fees & Acquisition Costs
    agencyFees: Float
    notaryFees: Float
    renovationFees: Float
    furnishingCosts: Float

    # Rental Stream
    rentalType: String
    rentalPeriod: String
    monthlyRent: Float
    utilityCosts: Float
    yearlyMiscCosts: Float

    # Amenities
    hasGarden: Boolean
    hasBalcony: Boolean
    hasLift: Boolean
    hasPool: Boolean
    hasSauna: Boolean
    isFurnished: Boolean
    isNewConstruction: Boolean

    # Quality details
    kitchenQuality: String
    kitchenCondition: String
    bathroomQuality: String
    bathroomCondition: String
    flooringQuality: String
    flooringCondition: String
    windowsQuality: String
    windowsCondition: String
    generalQuality: String
    generalCondition: String

    # Debt & Ownership Structure
    linkedLoanId: ID
    ownershipPercentage: Float
    ownershipStructure: String

    # BAN Geocoding
    addressLabel: String
    cityCode: String
    banId: String
    latitude: Float
    longitude: Float
    hasOutdoor: Boolean
    isGroundFloor: Boolean

    # Financial & Valuation
    valuationMode: ValuationMode
    estimationMethod: EstimationMethod
    manualValue: Float
    estimatedValue: Float
    estimatedMin: Float
    estimatedMax: Float
    estimatedPricePerM2: Float
    basePricePerM2: Float
    valuationConfidence: ValuationConfidence
    comparablesCount: Int
    searchRadiusMeters: Int
    lastEstimatedAt: Time
    valuationHistory: [RealEstateValuationPoint!]

    # Carte des loyers 2025
    marketRentPerM2: Float
    estimatedMonthlyRent: Float
    estimatedGrossYield: Float
    rentalR2Adjusted: Float

    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type LifeInsurance implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    policyNumber: String!
    insurer: String!
    policyType: String!
    coverageAmount: Float!
    premiumAmount: Float!
    premiumFrequency: String!
    beneficiaries: [String!]!
    maturityDate: Time
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Watch implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    brand: String!
    model: String!
    serialNumber: String
    referenceNumber: String
    condition: String!
    yearMade: Int
    material: String!
    movement: String!
    caseSize: Float
    waterResistance: Int
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Loan implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    description: String
    loanType: String!
    loanAmount: Float!
    remainingBalance: Float!
    interestRate: Float
    durationMonths: Int!
    monthlyPayment: Float!
    startDate: String!
    endDate: String
    lender: String!
    loanNumber: String
    currency: String!
    downPayment: Float
    status: String!
    ownershipMode: String
    applicationFee: Float
    brokerFee: Float
    insuranceFee: Float
    otherFees: Float
    earlyRepaymentFee: Float
    linkedAssetIDs: [ID!]
    ownershipPercentage: Float
    coOwners: [LoanCoOwner!]
    companyOwners: [LoanCompanyOwner!]
    steps: [LoanStep!]
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type LoanStep {
    id: ID!
    date: String
    amount: Float!
    interestRate: Float!
}

type LoanCoOwner {
    id: ID!
    type: String!
    userId: ID
    name: String!
    percentage: Float!
}

type LoanCompanyOwner {
    id: ID!
    type: String!
    companyId: ID
    name: String!
    registrationNumber: String
    legalForm: String
    percentage: Float!
}

type Tag {
    id: ID!
    name: String!
}

# Input for creating a new Stock asset
input CreateStockInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    ticker: String!
    quantity: Float!
    quoteCurrency: String!
}

# Input for creating a new Crypto asset
input CreateCryptoInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    walletAddress: String
    blockchainNetwork: String
    quantity: Float!
    quoteCurrency: String!
}

# Input for creating a new Fund asset
input CreateFundInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    ticker: String!
    quantity: Float!
}

