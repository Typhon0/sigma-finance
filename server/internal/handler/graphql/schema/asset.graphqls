    monthlyPayment: Float!
    startDate: String!
    endDate: String
    lender: String!
    loanNumber: String
    currency: String!
    downPayment: Float
    status: String!
    ownershipMode: String
    applicationFee: Float
    brokerFee: Float
    insuranceFee: Float
    otherFees: Float
    earlyRepaymentFee: Float
    linkedAssetIDs: [ID!]
    ownershipPercentage: Float
    coOwners: [LoanCoOwnerInput!]
    companyOwners: [LoanCompanyOwnerInput!]
    steps: [LoanStepInput!]
