# internal/handler/graphql/schema/asset.graphqls

type AssetType {
    id: ID!
    name: String!
}

interface Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!
    positions: [Position!]!
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
}

type Stock implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    ticker: String!
    quantity: Float!
    buyingPrice: Float
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Crypto implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    walletAddress: String
    blockchainNetwork: String
    quantity: Float!
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Fund implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    ticker: String!
    quantity: Float!
    buyingPrice: Float
    sector: String
    exchange: String
    fundType: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type BankAccount implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    accountType: String!
    institution: String!
    accountNumber: String!
    currency: String!
    interestRate: Float
    balance: Float
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type RealEstate implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    propertyType: String!
    address: String!
    city: String!
    state: String
    country: String!
    zipCode: String
    squareFeet: Int
    yearBuilt: Int
    bedrooms: Int
    bathrooms: Float
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type LifeInsurance implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    policyNumber: String!
    insurer: String!
    policyType: String!
    coverageAmount: Float!
    premiumAmount: Float!
    premiumFrequency: String!
    beneficiaries: [String!]!
    maturityDate: Time
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Watch implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    brand: String!
    model: String!
    serialNumber: String
    referenceNumber: String
    condition: String!
    yearMade: Int
    material: String!
    movement: String!
    caseSize: Float
    waterResistance: Int
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Loan implements Asset {
    id: ID!
    name: String!
    symbol: String
    assetType: AssetType!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    tags: [Tag!]!

    description: String
    loanType: String!
    loanAmount: Float!
    remainingBalance: Float!
    interestRate: Float!
    durationMonths: Int!
    monthlyPayment: Float!
    startDate: String!
    endDate: String
    lender: String!
    loanNumber: String
    currency: String!
    downPayment: Float
    status: String!
    ownershipMode: String
    applicationFee: Float
    brokerFee: Float
    insuranceFee: Float
    otherFees: Float
    earlyRepaymentFee: Float
    sector: String
    exchange: String
    dayChange: Float
    dayChangePercent: Float
    positions: [Position!]!
}

type Tag {
    id: ID!
    name: String!
}

# Input for creating a new Stock asset
input CreateStockInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    ticker: String!
    quantity: Float!
}

# Input for creating a new Crypto asset
input CreateCryptoInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    walletAddress: String
    blockchainNetwork: String
    quantity: Float!
}

# Input for creating a new Fund asset
input CreateFundInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    ticker: String!
    quantity: Float!
}

# Input for creating a new BankAccount asset
input CreateBankAccountInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    accountType: String!
    institution: String!
    accountNumber: String!
    currency: String!
    interestRate: Float
}

# Input for creating a new RealEstate asset
input CreateRealEstateInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    propertyType: String!
    address: String!
    city: String!
    state: String
    country: String!
    zipCode: String
    squareFeet: Int
    yearBuilt: Int
    bedrooms: Int
    bathrooms: Float
}

# Input for creating a new LifeInsurance asset
input CreateLifeInsuranceInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    policyNumber: String!
    insurer: String!
    policyType: String!
    coverageAmount: Float!
    premiumAmount: Float!
    premiumFrequency: String!
    beneficiaries: [String!]!
    maturityDate: Time
}

# Input for creating a new Loan asset
input CreateLoanInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    description: String
    loanType: String!
    loanAmount: Float!
    remainingBalance: Float!
    interestRate: Float!
    durationMonths: Int!
    monthlyPayment: Float!
    startDate: String!
    endDate: String
    lender: String!
    loanNumber: String
    currency: String!
    downPayment: Float
    status: String!
    ownershipMode: String
    applicationFee: Float
    brokerFee: Float
    insuranceFee: Float
    otherFees: Float
    earlyRepaymentFee: Float
}

# Input for creating a new Watch asset
input CreateWatchInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    brand: String!
    model: String!
    serialNumber: String
    referenceNumber: String
    condition: String!
    yearMade: Int
    material: String!
    movement: String!
    caseSize: Float
    waterResistance: Int
}

input AssetFilter {
    userID: ID
    assetTypeID: ID
    nameContains: String
    hasTagIDs: [ID!]
}

input AssetOrder {
    field: AssetOrderField! = NAME
    direction: SortDirection! = ASC
}

enum AssetOrderField {
    NAME
    CURRENT_VALUE
    PURCHASE_DATE
}
