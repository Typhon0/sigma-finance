    generalCondition: String
}

# Input for creating a new LifeInsurance asset
input CreateLifeInsuranceInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    policyNumber: String!
    insurer: String!
    policyType: String!
    coverageAmount: Float!
    premiumAmount: Float!
    premiumFrequency: String!
    beneficiaries: [String!]!
    maturityDate: Time
}

# Input for creating a new Loan asset
input CreateLoanInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    description: String
    loanType: String!
    loanAmount: Float!
    remainingBalance: Float!
    interestRate: Float!
    durationMonths: Int!
    monthlyPayment: Float!
    startDate: String!
    endDate: String
    lender: String!
    loanNumber: String
    currency: String!
    downPayment: Float
    status: String!
    ownershipMode: String
    applicationFee: Float
    brokerFee: Float
    insuranceFee: Float
    otherFees: Float
    earlyRepaymentFee: Float
    linkedAssetIDs: [ID!]
    ownershipPercentage: Float
    coOwners: [LoanCoOwnerInput!]
    companyOwners: [LoanCompanyOwnerInput!]
    steps: [LoanStepInput!]
}

input LoanStepInput {
    id: ID!
    date: String
    amount: Float!
    interestRate: Float!
}

input LoanCoOwnerInput {
    id: ID!
    type: String!
    userId: ID
    name: String!
    percentage: Float!
}

input LoanCompanyOwnerInput {
    id: ID!
    type: String!
    companyId: ID
    name: String!
    registrationNumber: String
    legalForm: String
    percentage: Float!
}

# Input for creating a new Watch asset
input CreateWatchInput {
    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    brand: String!
    model: String!
    serialNumber: String
    referenceNumber: String
    condition: String!
    yearMade: Int
    material: String!
    movement: String!
    caseSize: Float
    waterResistance: Int
}

input AssetFilter {
    userID: ID
    assetTypeID: ID
    nameContains: String
    hasTagIDs: [ID!]
}

input AssetOrder {
    field: AssetOrderField! = NAME
    direction: SortDirection! = ASC
}

enum AssetOrderField {
    NAME
    CURRENT_VALUE
    PURCHASE_DATE
}
