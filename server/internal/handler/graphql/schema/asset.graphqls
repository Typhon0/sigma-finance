    name: String!
    assetTypeID: ID!
    currentValue: Float
    purchaseDate: Time
    purchasePrice: Float
    brand: String!
    model: String!
    serialNumber: String
    referenceNumber: String
    condition: String!
    yearMade: Int
    material: String!
    movement: String!
    caseSize: Float
    waterResistance: Int
}

input AssetFilter {
    userID: ID
    assetTypeID: ID
    nameContains: String
    hasTagIDs: [ID!]
}

input AssetOrder {
    field: AssetOrderField! = NAME
    direction: SortDirection! = ASC
}

enum AssetOrderField {
    NAME
    CURRENT_VALUE
    PURCHASE_DATE
}

# --- Real Estate Auto-Valuation ---

enum ValuationMode {
    AUTO
    MANUAL
}

enum EstimationMethod {
    DVF_COMPARABLES
    INSEE_INDEX
    ACQUISITION_COST
}

enum ValuationConfidence {
    HIGH
    MEDIUM
    LOW
    UNAVAILABLE
}

type RealEstateValuationPoint {
    date: Time!
    value: Float!
    mode: String
    estimatedMin: Float
    estimatedMax: Float
}

type ADEMEDpeResult {
    rating: String!
    surfaceM2: Float
    diagnosticDate: String
    sourceDataset: String
}

type RealEstateRentalMarket {
    marketRentPerM2: Float
    estimatedMonthlyRent: Float
    estimatedGrossYield: Float
    isCommuneLevel: Boolean!
    r2Adjusted: Float
    sourceLabel: String!
}

type RealEstateEstimationResult {
    estimatedValue: Float
    estimatedMin: Float
    estimatedMax: Float
    estimatedPricePerM2: Float
    basePricePerM2: Float
    confidence: ValuationConfidence!
    method: EstimationMethod!
    comparablesCount: Int!
    searchRadiusMeters: Int
    lastEstimatedAt: Time!
    rentalMarket: RealEstateRentalMarket
}

input RealEstateEstimationInput {
    propertyType: String!
    surfaceM2: Float!
    latitude: Float
    longitude: Float
    cityCode: String
    address: String
    city: String
    postcode: String
    banId: String
    energyLabel: String
    condition: String
    purchasePrice: Float
    purchaseDate: Time
    isGroundFloor: Boolean
    hasOutdoor: Boolean
    roomsCount: Int
}

extend type Query {
    estimateRealEstate(input: RealEstateEstimationInput!): RealEstateEstimationResult! @auth
    fetchADEMEDpe(banId: String!, surfaceM2: Float!, propertyType: String): ADEMEDpeResult @auth
    getCommuneRentalIndicators(cityCode: String!, propertyType: String, roomsCount: Int, surfaceM2: Float, propertyValue: Float): RealEstateRentalMarket @auth
}

extend type Mutation {
    refreshRealEstateValuation(id: ID!): RealEstate! @auth
}

