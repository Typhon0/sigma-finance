# internal/handler/graphql/schema/portfolio.graphqls

enum TaxWrapperType {
    STANDARD_TAXABLE
    PEA
    RETIREMENT_SHELTERED
    CRYPTO_VAULT
}

type Portfolio {
    id: ID!
    name: String!
    description: String
    taxWrapper: TaxWrapperType!
    sortOrder: Int!
    createdAt: Time!
    updatedAt: Time!
    user: User!
    tags: [Tag!]!
    accounts: [Account!]!
    assets: [PortfolioAsset!]!
    transactions: [Transaction!]!
    analytics: PortfolioAnalytics
}

type PortfolioAsset {
    asset: Asset!
    instrumentID: ID
    quantity: Float!
    averagePurchasePrice: Float
    currentValue: Float
    ownershipPct: Float
    dayChange: Float
    dayChangePercent: Float
    quoteCurrency: String
}

type PortfolioAnalytics {
    totalValue: Float!
    totalCost: Float!
    totalGainLoss: Float!
    totalGainLossPercent: Float!
    assetAllocation: [AssetAllocation!]!
    riskMetrics: RiskMetrics!
    performanceHistory: [PerformancePoint!]!
    # Multi-currency fields
    totalNativeValue: Float
    totalDisplayValue: Float
    fxAsOf: Time
    fxSource: String
    fxGranularity: String
    isStale: Boolean
    fxState: String
    excludedPositionCount: Int
    coveredValueRatio: Float
    displayCurrency: String
    quoteCurrency: String
    positionValuations: [PositionValuation!]
}

type PositionValuation {
    positionId: ID!
    assetId: ID!
    nativeValue: Float!
    displayValue: Float!
    costBasisNative: Float!
    costBasisDisplay: Float!
    # Currency the remaining cost basis is denominated in. Equal to
    # displayCurrency when the basis was converted at a stored rate; otherwise
    # the percentage return for this position is not computable and clients
    # must not derive one.
    costBasisCurrency: String!
    # True only when every remaining cost-basis lot was either already in the
    # display currency or converted at the FX rate that prevailed on its own
    # execution date. There is deliberately no latest-rate fallback. False
    # means the percentage return is not computable and clients must not
    # derive one from the raw basis.
    costBasisConverted: Boolean!
    # False when no display-currency value could be produced (missing price or
    # missing FX rate). Clients must treat displayValue as unavailable.
    hasDisplayValue: Boolean!
    isExcluded: Boolean!
    exclusionReason: String
    fxRate: Float!
    fxAsOf: Time
    fxSource: String
    fxGranularity: String
    isStale: Boolean!
    quoteCurrency: String!
    displayCurrency: String!
}

type AssetAllocation {
    assetType: String!
    value: Float!
    percentage: Float!
    count: Int!
}

# Risk metrics are nullable throughout.
#
# They were previously non-null and, on the portfolio-valuation path, filled
# with literal zeros. A zero Sharpe ratio is indistinguishable from a genuinely
# mediocre risk-adjusted return, and a zero max drawdown reads as "this portfolio
# never fell" - so the API asserted a confident measurement it had not made.
# Null now means "not computed for this portfolio", which is the truth.
type RiskMetrics {
    volatility: Float
    sharpeRatio: Float
    sortinoRatio: Float
    maxDrawdown: Float
    diversification: Float
}

type PerformancePoint {
    date: Time!
    value: Float!
}

# --- Inputs & Enums for Portfolio ---

input CreatePortfolioInput {
    userID: ID!
    name: String!
    description: String
    taxWrapper: TaxWrapperType
}

input UpdatePortfolioInput {
    name: String
    description: String
    taxWrapper: TaxWrapperType
    sortOrder: Int
}

input PortfolioAssetInput {
    portfolioID: ID!
    assetID: ID!
    quantity: Float!
    averagePurchasePrice: Float
}

input PortfolioFilter {
    userID: ID
    nameContains: String
    hasTagIDs: [ID!]
}

input PortfolioOrder {
    field: PortfolioOrderField! = NAME
    direction: SortDirection! = ASC
}

enum PortfolioOrderField {
    NAME
    SORT_ORDER
    CREATED_AT
    UPDATED_AT
}

input DuplicatePortfolioInput {
    sourcePortfolioID: ID!
    newName: String!
    description: String
    copyAssets: Boolean! = true
}

input ReorderPortfoliosInput {
    userID: ID!
    portfolioOrders: [PortfolioOrderInput!]!
}

input PortfolioOrderInput {
    portfolioID: ID!
    sortOrder: Int!
}

input ExportPortfolioInput {
    portfolioID: ID!
    format: ExportFormat!
    includeTransactions: Boolean! = true
    includeAnalytics: Boolean! = true
}

enum ExportFormat {
    CSV
    PDF
    EXCEL
}

type ExportResult {
    success: Boolean!
    downloadUrl: String
    error: String
}
