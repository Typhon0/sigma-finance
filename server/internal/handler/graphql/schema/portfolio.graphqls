# internal/handler/graphql/schema/portfolio.graphqls

type Portfolio {
    id: ID!
    name: String!
    description: String
    sortOrder: Int!
    createdAt: Time!
    updatedAt: Time!
    user: User!
    tags: [Tag!]!
    assets: [PortfolioAsset!]!
    transactions: [Transaction!]!
    analytics: PortfolioAnalytics
}

type PortfolioAsset {
    asset: Asset!
    instrumentID: ID
    quantity: Float!
    averagePurchasePrice: Float
    currentValue: Float
    ownershipPct: Float
    dayChange: Float
    dayChangePercent: Float
}

type PortfolioAnalytics {
    totalValue: Float!
    totalCost: Float!
    totalGainLoss: Float!
    totalGainLossPercent: Float!
    assetAllocation: [AssetAllocation!]!
    riskMetrics: RiskMetrics!
    performanceHistory: [PerformancePoint!]!
}

type AssetAllocation {
    assetType: String!
    value: Float!
    percentage: Float!
    count: Int!
}

type RiskMetrics {
    volatility: Float!
    sharpeRatio: Float!
    maxDrawdown: Float!
    diversification: Float!
}

type PerformancePoint {
    date: Time!
    value: Float!
}

# --- Inputs & Enums for Portfolio ---

input CreatePortfolioInput {
    userID: ID!
    name: String!
    description: String
}

input UpdatePortfolioInput {
    name: String
    description: String
    sortOrder: Int
}

input PortfolioAssetInput {
    portfolioID: ID!
    assetID: ID!
    quantity: Float!
    averagePurchasePrice: Float
}

input PortfolioFilter {
    userID: ID
    nameContains: String
    hasTagIDs: [ID!]
}

input PortfolioOrder {
    field: PortfolioOrderField! = NAME
    direction: SortDirection! = ASC
}

enum PortfolioOrderField {
    NAME
    SORT_ORDER
    CREATED_AT
    UPDATED_AT
}

input DuplicatePortfolioInput {
    sourcePortfolioID: ID!
    newName: String!
    description: String
    copyAssets: Boolean! = true
}

input ReorderPortfoliosInput {
    userID: ID!
    portfolioOrders: [PortfolioOrderInput!]!
}

input PortfolioOrderInput {
    portfolioID: ID!
    sortOrder: Int!
}

input ExportPortfolioInput {
    portfolioID: ID!
    format: ExportFormat!
    includeTransactions: Boolean! = true
    includeAnalytics: Boolean! = true
}

enum ExportFormat {
    CSV
    PDF
    EXCEL
}

type ExportResult {
    success: Boolean!
    downloadUrl: String
    error: String
}
