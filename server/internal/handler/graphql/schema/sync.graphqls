# internal/handler/graphql/schema/sync.graphqls

enum SyncProvider {
    KRAKEN
    SNAPTRADE
    GOCARDLESS
    TRADEREPUBLIC
    ENABLEBANKING
    WOOB
    MANUAL
}

enum WoobAuthStatus {
    WAITING_FOR_CONFIRMATION
    WAITING_FOR_CODE
    COMPLETED
    REJECTED
    EXPIRED
}

type WoobAuthSession {
    authSessionId: ID!
    status: WoobAuthStatus!
    countdownSeconds: Int!
    challengeMessage: String
    expiresAt: Time!
}

type WoobAuthPollResult {
    status: WoobAuthStatus!
    connections: [SyncConnection!]
    errorMessage: String
}

enum TradeRepublicAuthStatus {
    WAITING_FOR_CONFIRMATION
    COMPLETED
    REJECTED
    EXPIRED
}

type TradeRepublicAuthSession {
    authSessionId: ID!
    status: TradeRepublicAuthStatus!
    countdownSeconds: Int!
    expiresAt: Time!
}

type TradeRepublicAuthPollResult {
    status: TradeRepublicAuthStatus!
    connections: [SyncConnection!]
    errorMessage: String
}

enum SyncConnectionStatus {
    IDLE
    SYNCING
    SUCCESS
    FAILED
}

enum SyncRunStatus {
    IN_PROGRESS
    COMPLETED
    FAILED
}

type SyncCredential {
    id: ID!
    provider: String!
    status: String!
    source: String
    createdAt: Time!
    updatedAt: Time!
}

type SyncConnection {
    id: ID!
    portfolioId: ID!
    accountId: ID
    account: Account
    provider: String!
    externalInstitutionId: String!
    externalAccountId: String!
    institutionName: String!
    syncStatus: String!
    lastSyncAt: Time
    lastError: String
    createdAt: Time!
    updatedAt: Time!
}

type SyncRun {
    id: ID!
    connectionId: ID!
    status: String!
    itemsImported: Int!
    itemsUpdated: Int!
    errorMessage: String
    startedAt: Time!
    completedAt: Time
}

type AggregatorAuthSession {
    link: String!
    sessionToken: String!
    provider: String!
}

type EnableBankingInstitution {
    name: String!
    title: String!
    country: String!
    logo: String
    psuTypes: [String!]
}

type EnableBankingAuthSession {
    authSessionId: ID!
    authUrl: String!
    state: String!
    expiresAt: Time!
}

extend type Query {
    syncConnections(portfolioId: ID!): [SyncConnection!]! @auth
    syncCredentials: [SyncCredential!]! @auth
    enableBankingInstitutions(country: String!): [EnableBankingInstitution!]! @auth
}

extend type Mutation {
    registerSyncCredential(provider: String!, credentials: JSON!, portfolioId: ID): SyncCredential! @auth
    generateAggregatorLink(provider: String!, redirectUrl: String!): AggregatorAuthSession! @auth
    completeAggregatorAuth(connectionId: ID!, sessionToken: String!): [SyncConnection!]! @auth
    linkSyncAccount(connectionId: ID!, accountId: ID, autoCreate: Boolean): SyncConnection! @auth
    triggerAccountSync(accountId: ID!): SyncRun! @auth
    initiateTradeRepublicAuth(phoneNumber: String!, pin: String!, portfolioId: ID!): TradeRepublicAuthSession! @auth
    pollTradeRepublicAuth(authSessionId: ID!): TradeRepublicAuthPollResult! @auth
    initiateEnableBankingAuth(aspspName: String!, aspspCountry: String!, redirectUrl: String!, portfolioId: ID!): EnableBankingAuthSession! @auth
    completeEnableBankingAuth(code: String!, state: String!, portfolioId: ID!): [SyncConnection!]! @auth
    initiateWoobAuth(institution: String!, login: String!, password: String!, region: String, portfolioId: ID!): WoobAuthSession! @auth
    pollWoobAuth(authSessionId: ID!, otpCode: String): WoobAuthPollResult! @auth
}
