# Market Data Schema

extend type Query {
  # Market Data
  candles(symbol: String!, assetType: String!, interval: String!, from: Time!, to: Time!, limit: Int = 500): [Candle!]! @auth
  candlesByInstrument(instrumentId: ID!, interval: String!, from: Time!, to: Time!, limit: Int = 500, preferredProvider: String): MarketDataCandlesPayload! @auth
  marketDataCredentials: [MarketDataCredential!]! @auth
  supportedProviders(assetType: String): [ProviderInfo!]! @auth
  availableProviders(instrumentId: ID!, dataType: String!): [AvailableProvider!]! @auth
  providerHealth: [ProviderHealth!]! @auth
  realTimePrice(symbol: String!, assetType: String!): Candle @auth
  realTimePriceByInstrument(instrumentId: ID!, preferredProvider: String): MarketDataCandlePayload @auth

  # Asset Price History (from database - for tracked assets)
  assetPriceHistory(assetId: ID!, from: Time!, to: Time!, limit: Int): [AssetPricePoint!]! @auth
  assetPriceStatistics(assetId: ID!): AssetPriceStatistics! @auth

  # Technical Indicators (via Alpha Vantage)
  technicalIndicator(
    symbol: String!
    assetType: String!
    indicator: String!
    interval: String!
    timePeriod: Int!
    seriesType: String!
    from: Time
    to: Time
  ): TechnicalIndicatorResponse! @auth

  # Provider routing preferences
  providerRoutingPreferences: ProviderRoutingPreferences! @auth
}

extend type Mutation {
    # Market Data
    upsertMarketDataCredential(provider: String!, apiKey: String!, isEnabled: Boolean, priority: Int): MarketDataCredential! @auth
    deleteMarketDataCredential(provider: String!): ID! @auth
    validateProviderCredentials(provider: String!, apiKey: String!): ValidationResult! @auth

    # Asset price management
    refreshAssetPrices(assetId: ID): RefreshAssetPricesResult! @auth
    refreshSingleAssetPrice(assetId: ID!): AssetPricePoint! @auth

    # Provider routing preferences
    updateProviderRoutingPreferences(input: ProviderRoutingPreferencesInput!): ProviderRoutingPreferences! @auth
}

# Market Data Types
type Candle {
    symbol: String!
    assetType: String!
    interval: String!
    open: Float!
    high: Float!
    low: Float!
    close: Float!
    volume: Float
    timestamp: Time!
    source: String!
}

type MarketDataCredential {
    id: ID!
    provider: String!
    isEnabled: Boolean!
    priority: Int!
    lastValidatedAt: Time
    createdAt: Time!
    updatedAt: Time!
}

type ProviderFailure {
    provider: String!
    reason: String!
}

type MarketDataCandlesPayload {
    candles: [Candle!]!
    sourceProvider: String!
    fallbackUsed: Boolean!
    failures: [ProviderFailure!]!
}

type MarketDataCandlePayload {
    candle: Candle
    sourceProvider: String!
    fallbackUsed: Boolean!
    failures: [ProviderFailure!]!
}

type AvailableProvider {
    provider: String!
    capability: Boolean!
    requiresApiKey: Boolean!
    hasCredential: Boolean!
    credentialValid: Boolean!
    credentialEnabled: Boolean!
    priority: Int!
    mappingStatus: String!
    effectiveEnabled: Boolean!
}

type ProviderInfo {
    id: String!
    name: String!
    type: String!
    requiresKey: Boolean!
    intervals: [String!]!
    rateLimit: RateLimit!
    supportsRealtime: Boolean!
}

type RateLimit {
    requestsPerMinute: Int!
    requestsPerDay: Int!
    burstLimit: Int!
}

type ProviderHealth {
    provider: String!
    assetType: String!
    healthy: Boolean!
    apiKeyValid: Boolean
    lastChecked: Time!
}

type ValidationResult {
    valid: Boolean!
    message: String
}

type RefreshAssetPricesResult {
    success: Boolean!
    message: String
    updatedCount: Int
    errors: [String!]
}

# Technical Indicator Types
type TechnicalIndicatorResponse {
    indicator: String!
    symbol: String!
    data: [TechnicalIndicatorPoint!]!
    source: String!
    timestamp: Time!
}

type TechnicalIndicatorPoint {
    timestamp: Time!
    value: Float!
    signal: Float
    histogram: Float
    upperBand: Float
    lowerBand: Float
}

# Provider Routing Preferences
type ProviderRoutingPreferences {
  id: ID!
  userId: String!
  preferredProviders: [ProviderPreference!]!
  useIntelligentRouting: Boolean!
  enableFallback: Boolean!
  staleDataThresholdMinutes: Int!
  createdAt: Time!
  updatedAt: Time!
}

type ProviderPreference {
  provider: String!
  priority: Int!
  enabled: Boolean!
}

# Asset Price History Types
type AssetPricePoint {
  id: ID!
  assetId: ID!
  price: Float!
  volume: Float
  marketCap: Float
  timestamp: Time!
  source: String!
}

type AssetPriceStatistics {
  assetId: ID!
  currentPrice: Float!
  previousPrice: Float!
  change: Float!
  changePercent: Float!
  dayHigh: Float!
  dayLow: Float!
  weekHigh: Float!
  weekLow: Float!
  monthHigh: Float!
  monthLow: Float!
  yearHigh: Float!
  yearLow: Float!
  averageVolume: Float
  lastUpdated: Time!
  isStale: Boolean!
}

input ProviderRoutingPreferencesInput {
  preferredProviders: [ProviderPreferenceInput!]!
  useIntelligentRouting: Boolean
  enableFallback: Boolean
  staleDataThresholdMinutes: Int
}

input ProviderPreferenceInput {
  provider: String!
  priority: Int!
  enabled: Boolean!
}
