# Example Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Environment (development, production, staging)
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=sigma_finance
DB_SSLMODE=require

# Test Database Configuration (for running tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=your_secure_password
TEST_DB_NAME=sigma_finance_test
TEST_DB_SSLMODE=disable

# JWT Configuration
# IMPORTANT: Generate a secure random secret for production!
# You can use: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ALGORITHM=HS256
JWT_ISSUER=sigma-finance

# Security Configuration
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION=30m
RATE_LIMIT_WINDOW=15m
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=24h

# Authentication Configuration
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_REGISTRATION=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Your App Name
BASE_URL=https://yourdomain.com

# Optional: Redis Configuration (for distributed rate limiting)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0