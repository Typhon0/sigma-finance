# Example Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Environment (development, production, staging)
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=sigma_finance
DB_SSLMODE=require

# Migration / admin database configuration
# Use these when the app user does not own the existing tables and migrations need elevated privileges.
DB_ADMIN_HOST=localhost
DB_ADMIN_PORT=5432
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=your_secure_password
DB_ADMIN_NAME=sigma_finance
DB_ADMIN_SSLMODE=require

# Test Database Configuration (for running tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=sigma_finance
TEST_DB_PASSWORD=your_secure_password
TEST_DB_NAME=sigma_finance_test
TEST_DB_SSLMODE=disable

# Admin (superuser) credentials for test DB setup and schema permissions
# Falls back to TEST_DB_* values if not set
TEST_DB_ADMIN_HOST=localhost
TEST_DB_ADMIN_PORT=5432
TEST_DB_ADMIN_USER=postgres
TEST_DB_ADMIN_PASSWORD=your_secure_password

# JWT Configuration
# IMPORTANT: Generate a secure random secret for production!
# You can use: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ALGORITHM=HS256
JWT_ISSUER=sigma-finance

# Security Configuration
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION=30m
RATE_LIMIT_WINDOW=15m
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=24h

# Authentication Configuration
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_REGISTRATION=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Your App Name
BASE_URL=https://yourdomain.com

# Market Data Configuration
# Encryption key for API key storage (auto-generated if not set)
# ENCRYPTION_KEY=
# CANDLE_REQUESTS_PER_MINUTE=60
# COINGECKO_DEMO_API_KEY=
# COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# YFinance Sidecar (tier 3 fallback provider, no API key needed)
# Set these when running the yfinance-service sidecar (see server/cmd/yfinance-service/)
# YFINANCE_HOST=localhost
# YFINANCE_PORT=50051

# Optional: Redis Configuration (for distributed rate limiting)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
