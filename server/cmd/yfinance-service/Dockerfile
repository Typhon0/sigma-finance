# ---- Dev stage: type-check and validate during build ----
FROM python:3.11-slim AS dev

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install dev dependencies for type checking
RUN pip install --no-cache-dir \
    "mypy>=1.10,<1.20" \
    types-protobuf \
    types-grpcio \
    pandas-stubs

# Copy application code, proto stubs, and mypy config
COPY . .

# Proto stubs (proto/*.pyi) are auto-generated by generate_proto.sh.
# Run ./generate_proto.sh locally when the .proto file changes,
# then commit the updated stubs.
#
# Proto sync check (./generate_proto.sh --check) runs in run_tests.sh
# or CI, where the .proto source file at the project root is accessible.
# The Docker build context doesn't include it.

# Run mypy type check — fails the build if type errors are found
RUN python -m mypy cache.py rate_limiter.py validation.py servicer.py \
    --config-file pyproject.toml --no-incremental

# ---- Runtime stage: production image ----
FROM python:3.11-slim

# Create non-root user
RUN useradd -u 1000 -m -s /bin/bash appuser

WORKDIR /app

# Install production dependencies only
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install pytest for integration testing (lightweight, useful in deployed environments)
RUN pip install --no-cache-dir pytest>=8.0 pandas>=2.0 numpy>=1.24

# Copy application code from dev stage
COPY --from=dev /app .

# Switch to non-root user
USER appuser

# Expose gRPC port
EXPOSE 50051

# Run the service
CMD ["python", "servicer.py"]
